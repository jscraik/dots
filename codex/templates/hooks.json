{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/pre-tool-use-dispatch.sh",
            "timeout": 130
          }
        ]
      },
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/pre-tool-use-guard.sh",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "@BRAID_COMMAND@ hook codex --capture",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/post-tool-use-review.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/post-tool-use-review.sh",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "@BRAID_COMMAND@ hook codex --capture",
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear)$",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/session-start.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "@BRAID_COMMAND@ hook codex --inject",
            "additionalContextLimit": 2500
          },
          {
            "type": "command",
            "command": "@BRAID_COMMAND@ hook codex --capture"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "^(manual|auto)$",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/pre-compact-guard.sh",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "@BRAID_COMMAND@ hook codex --capture",
            "async": true
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "^(manual|auto)$",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/post-compact-recorder.sh",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "@BRAID_COMMAND@ hook codex --capture",
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/subagent-start.sh",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "@BRAID_COMMAND@ hook codex --inject",
            "additionalContextLimit": 2500
          },
          {
            "type": "command",
            "command": "@BRAID_COMMAND@ hook codex --capture"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/subagent-stop.sh",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "@BRAID_COMMAND@ hook codex --capture"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/permission-request-guard.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/permission-request-guard.sh",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "@BRAID_COMMAND@ hook codex --capture",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/user-prompt-submit.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.codex/hooks/lifeos-codex.sh",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "@BRAID_COMMAND@ hook codex --inject",
            "additionalContextLimit": 2500
          },
          {
            "type": "command",
            "command": "@BRAID_COMMAND@ hook codex --capture"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/stop-guard.sh",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "@BRAID_COMMAND@ hook codex --capture"
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "@BRAID_COMMAND@ hook codex --capture"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "other",
        "hooks": [
          {
            "type": "command",
            "command": "@BRAID_COMMAND@ hook codex --capture"
          }
        ]
      }
    ]
  }
}
